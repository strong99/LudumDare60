<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WasmMainJSPath>main.js</WasmMainJSPath>
		<ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Raylib-cs" Version="8.1.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\LudumDare60\LudumDare60.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Workaround: WasmFilesToIncludeInFileSystem doesn't work with this set up -->
		<EmbeddedResource Include="..\LudumDare60\Assets\**\*" Visible="false" LogicalName="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<EmccFlags>-sUSE_GLFW=3</EmccFlags>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<!-- Raylib-cs has a newer EMCC version, skip optimization. -->
		<EmccLinkOptimizationFlag>-O1</EmccLinkOptimizationFlag>
		<EmccFlags>-sUSE_GLFW=3</EmccFlags>
	</PropertyGroup>

</Project>
