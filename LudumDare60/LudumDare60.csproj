<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="LudumDare60" />
    <Using Include="LudumDare60.Behaviours" />
    <Using Include="LudumDare60.Enemies" />
    <Using Include="LudumDare60.GameStates" />
    <Using Include="LudumDare60.Tiles" />
    <Using Include="LudumDare60.UI" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Pipe.glb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Wall.glb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
	
</Project>
